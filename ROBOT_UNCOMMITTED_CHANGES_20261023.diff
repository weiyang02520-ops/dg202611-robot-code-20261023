+def test_camera_slots_publish_zed_commands_and_are_debounced():
+    now = [100.0]
+    backend = make_backend(lambda: now[0])
+
+    backend.startCamera()
+    backend.startCamera()
+    backend.stopCamera()
+    backend.stopCamera()
+    now[0] = 106.0
+    backend.stopCamera()
+
+    assert backend.bridge.system_commands == [
+        ('start_zed', {}),
+        ('stop_zed', {}),
+        ('stop_zed', {}),
+    ]
+    messages = [item.get('message', '') for item in backend.logs]
+    assert '系统命令: start_zed' in messages
+    assert '系统命令: stop_zed' in messages
+    assert '忽略重复系统命令: start_zed' in messages
+
+
+class FakeCameraProvider:
+    def __init__(self):
+        self.frames = []
+        self.clears = 0
+
+    def set_frame(self, image):
+        self.frames.append(image)
+
+    def clear(self):
+        self.clears += 1
+
+
+def test_camera_preview_activation_frames_and_stream_text():
+    now = [100.0]
+    provider = FakeCameraProvider()
+    backend = make_backend(lambda: now[0], camera_image_provider=provider)
+    frame = object()
+
+    backend.update_camera_frame(frame)
+    assert provider.frames == [] and backend.cameraFrameCounter == 0
+    assert backend.cameraStreamText == '相机未开启'
+
+    backend.setCameraPreviewActive(True)
+    backend.setCameraPreviewActive(True)
+    assert backend.bridge.camera_preview_requests == [True]
+    assert backend.cameraPreviewActive is True
+    assert provider.clears == 1
+
+    backend.update_system_status({'zed': 'running'})
+    assert backend.cameraStreamState == 'waiting'
+    assert backend.cameraStreamText == '等待画面…'
+
+    backend.update_camera_frame(frame)
+    backend.update_camera_frame(frame)
+    assert provider.frames == [frame, frame]
+    assert backend.cameraFrameCounter == 2
+    assert backend.cameraStreamText == '画面正常'
+
+    now[0] = 103.0
+    assert backend.cameraStreamText == '等待画面…'
+    backend.update_system_status({'zed': 'stopped'})
+    assert backend.cameraStreamText == '相机未开启'
+
+    backend.setCameraPreviewActive(False)
+    backend.update_camera_frame(frame)
+    assert backend.bridge.camera_preview_requests == [True, False]
+    assert backend.cameraPreviewActive is False
+    assert provider.frames == [frame, frame]
+
+    backend.setCameraPreviewActive(True)
+    assert backend.cameraFrameCounter == 0
+    assert provider.clears == 2
+
+
+def test_backend_shutdown_deactivates_camera_preview():
+    backend = make_backend(lambda: 100.0)
+    backend.startup_timer.stop()
+    backend.setCameraPreviewActive(True)
+
+    backend.shutdown()
+
+    assert backend.bridge.camera_preview_requests == [True, False]
+    assert backend.cameraPreviewActive is False
+
+
